[Unit]
Description=Auralytix Backend API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/auralytix
EnvironmentFile=/home/ubuntu/auralytix/.env
ExecStart=/home/ubuntu/auralytix/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
